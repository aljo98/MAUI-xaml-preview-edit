{
  "name": "maui-xaml-preview",
  "displayName": "MAUI XAML Preview",
  "description": "Prikaže predogled .NET MAUI XAML dokumentov in omogoča urejanje lastnosti ter testiranje na emulatorju.",
  "publisher": "aljo98",
  "version": "0.1.7",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aljo98/MAUI-xaml-preview-edit"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:mauiXamlPreview.openPreview",
    "onCommand:mauiXamlPreview.addEntity",
    "onLanguage:xaml",
    "workspaceContains:**/*.csproj"
  ],
  "contributes": {
    "languages": [
      {
        "id": "xaml",
        "extensions": [
          ".xaml"
        ],
        "aliases": [
          "XAML",
          "Xaml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "mauiXamlPreview.openPreview",
        "title": "Odpri MAUI XAML Preview",
        "category": ".NET MAUI",
        "icon": "$(preview)"
      },
      {
        "command": "mauiXamlPreview.addEntity",
        "title": "Vstavi MAUI kontrolnik…",
        "category": ".NET MAUI",
        "icon": "$(add)"
      },
      {
        "command": "mauiProperties.addProperty",
        "title": "Dodaj XAML lastnost…",
        "category": ".NET MAUI",
        "icon": "$(list-selection)"
      },
      {
        "command": "mauiProperties.editProperty",
        "title": "Uredi XAML lastnost…",
        "category": ".NET MAUI",
        "icon": "$(settings-gear)"
      },
      {
        "command": "mauiTemplates.scaffoldDocument",
        "title": "Scaffold dokumentno predlogo…",
        "category": ".NET MAUI",
        "icon": "$(file-code)"
      },
      {
        "command": "mauiEmulator.listDevices",
        "title": "📱 Seznam emulatorjev",
        "category": ".NET MAUI Emulator",
        "icon": "$(device-mobile)"
      },
      {
        "command": "mauiEmulator.start",
        "title": "▶️ Zaženi emulator",
        "category": ".NET MAUI Emulator",
        "icon": "$(play)"
      },
      {
        "command": "mauiEmulator.connectMetro",
        "title": "🔗 Poveži na Metro (Hot Reload)",
        "category": ".NET MAUI Emulator",
        "icon": "$(link)"
      },
      {
        "command": "mauiEmulator.checkMetro",
        "title": "✅ Preveri Metro status",
        "category": ".NET MAUI Emulator",
        "icon": "$(check)"
      },
      {
        "command": "mauiEmulator.restartAdb",
        "title": "🔄 Restart ADB",
        "category": ".NET MAUI Emulator",
        "icon": "$(refresh)"
      },
      {
        "command": "mauiEmulator.deviceInfo",
        "title": "ℹ️ Info o napravi",
        "category": ".NET MAUI Emulator",
        "icon": "$(info)"
      },
      {
        "command": "mauiScreenshot.deviceCapture",
        "title": "📱 Screenshot emulatorja",
        "category": ".NET MAUI Screenshot",
        "icon": "$(device-mobile)"
      },
      {
        "command": "mauiScreenshot.previewCapture",
        "title": "🖼️ Screenshot preview-ja",
        "category": ".NET MAUI Screenshot",
        "icon": "$(preview)"
      },
      {
        "command": "mauiScreenshot.showHtml",
        "title": "📄 Prikaži generirani HTML",
        "category": ".NET MAUI Screenshot",
        "icon": "$(code)"
      },
      {
        "command": "mauiScreenshot.compare",
        "title": "🔍 Primerjaj preview z realno app",
        "category": ".NET MAUI Screenshot",
        "icon": "$(diff)"
      },
      {
        "command": "mauiScreenshot.analyzeDifferences",
        "title": "📊 Analiziraj razlike",
        "category": ".NET MAUI Screenshot",
        "icon": "$(graph)"
      },
      {
        "command": "mauiScreenshot.openFolder",
        "title": "📂 Odpri screenshots mapo",
        "category": ".NET MAUI Screenshot",
        "icon": "$(folder)"
      },
      {
        "command": "mauiScreenshot.list",
        "title": "📋 Seznam screenshotov",
        "category": ".NET MAUI Screenshot",
        "icon": "$(list-tree)"
      },
      {
        "command": "mauiXamlPreview.copyAiContext",
        "title": "Copy AI Design Context",
        "category": ".NET MAUI",
        "icon": "$(clippy)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "maui-designer",
          "title": "MAUI Designer",
          "icon": "media/maui-designer.svg"
        }
      ]
    },
    "views": {
      "maui-designer": [
        {
          "id": "mauiProperties",
          "name": "Lastnosti",
          "type": "webview"
        },
        {
          "id": "mauiTemplates",
          "name": "Template primeri"
        },
        {
          "id": "mauiStructure",
          "name": "Struktura"
        },
        {
          "id": "mauiCodeBehind",
          "name": "Code-Behind Inspector"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "mauiEmulator.listDevices",
          "when": "editorLangId == xaml"
        },
        {
          "command": "mauiEmulator.start",
          "when": "editorLangId == xaml"
        },
        {
          "command": "mauiEmulator.connectMetro",
          "when": "editorLangId == xaml"
        },
        {
          "command": "mauiEmulator.checkMetro",
          "when": "editorLangId == xaml"
        }
      ],
      "editor/title": [
        {
          "command": "mauiXamlPreview.openPreview",
          "when": "resourceExtname == .xaml",
          "group": "navigation@10",
          "icon": "$(preview)"
        }
      ],
      "explorer/context": [
        {
          "command": "mauiXamlPreview.openPreview",
          "when": "resourceExtname == .xaml",
          "group": "navigation",
          "icon": "$(preview)"
        }
      ]
    }
  },
  "configuration": {
    "title": "MAUI XAML Preview",
    "properties": {
      "mauiXamlPreview.autoOpen": {
        "type": "boolean",
        "default": false,
        "description": "Avtomatsko odpri MAUI XAML Preview ko odprete .xaml datoteko."
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "lint": "echo 'No lint configured'",
    "package": "npm install && vsce package"
  },
  "devDependencies": {
    "@types/node": "20.19.17",
    "@types/vscode": "1.104.0",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "fast-xml-parser": "4.5.3"
  }
}